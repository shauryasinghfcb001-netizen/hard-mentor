# Copy to .env (git-ignored) and fill in locally. Never paste keys into chat.
# Primary provider: nvidia | openrouter | meterless
# meterless = Meterless Runtime (Nightshift hotspot). It never falls back to nvidia/openrouter.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
# Fallback provider (used by the smoke test only if NVIDIA fails)
OPENROUTER_API_KEY=
# Optional: override the primary provider's model id / base URL
# LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Planner flag: rules (default) | model
HM_PLANNER=rules
# Meterless Runtime (only when LLM_PROVIDER=meterless). Token: paste it here,
# or point METERLESS_STATE_DIR at the runtime state folder (it reads proxy-token).
meterless_runtime_token=
# METERLESS_STATE_DIR=
# METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# METERLESS_MODEL=meterless/auto
